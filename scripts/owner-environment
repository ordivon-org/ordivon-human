#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
python_bin=${PYTHON_BIN:-$(command -v python3 || true)}

usage() {
  cat <<'TXT'
usage: scripts/owner-environment doctor|test|cold-start

doctor      verify the dependency-free current reproducibility plane
test        replay current public executable Human artifacts
cold-start  prove the same gate from an unwarmed source copy

Human current authority remains document/question/core based. This command does
not create an AuthorityVersion registry, personal model, or Human runtime.
TXT
}

doctor() {
  [[ -n "$python_bin" && -x "$python_bin" ]] || { echo 'Human owner environment requires python3' >&2; exit 1; }
  "$python_bin" - <<'PY'
import sys
if sys.version_info < (3, 12):
    raise SystemExit(f"Human reproducibility requires Python >=3.12, got {sys.version.split()[0]}")
print(f"owner environment doctor: valid dependency-free python={sys.version.split()[0]}")
PY
}

run_tests() {
  doctor
  (cd "$repo" && PYTHON_BIN="$python_bin" scripts/check-reproducibility)
  echo 'owner environment test: passed'
}

case "$mode" in
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    doctor
    tmp=$(mktemp -d -t ordivon-human-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/repo"
    (cd "$repo" && tar --exclude=.git --exclude='__pycache__' --exclude='*.pyc' -cf - .) | tar -xf - -C "$tmp/repo"
    PYTHON_BIN="$python_bin" "$tmp/repo/scripts/owner-environment" test
    echo 'owner environment cold-start: passed'
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
